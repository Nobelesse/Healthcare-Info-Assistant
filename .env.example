# Copy to .env. Never commit .env or real medical data.
# On FIRST RUN, set a strong password (12+ characters) to create the permanent "Mr. Doc" account.
# After creation, remove this password from .env; the salted Argon2 hash remains in SQLite.
ADMIN_INITIAL_PASSWORD=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
WHISPER_MODEL=base
ENABLE_OCR=false
# Optional OCR: install requirements-ocr.txt AND Tesseract OCR on Windows
TESSERACT_CMD=
